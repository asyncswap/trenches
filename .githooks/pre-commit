#!/bin/sh
# Keep the generated shortcut docs in step with shortcuts.json.
#
# shortcuts.json is the only place a binding is written down. The in-app help and
# the Shortcuts page render from it directly, so they cannot be stale. Two
# things are files on disk and can be:
#
#   docs/shortcuts.md                    read on GitHub, not by the app
#   ../trenches.sh/src/shortcuts.json    the website's copy, another repo
#
# A test catches both, but only when someone runs it — and it is the commit
# that already changed shortcuts.json where the fix is free. So this
# regenerates rather than complains.
#
# It does nothing at all unless shortcuts.json is staged, which is the point:
# the cost lands on the few commits that touch the shortcuts and on no others.

set -e

git diff --cached --name-only | grep -qx 'shortcuts.json' || exit 0

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: shortcuts.json changed but cargo is not on PATH —" >&2
  echo "            docs/shortcuts.md was not regenerated" >&2
  exit 0
fi

echo "pre-commit: shortcuts.json changed, regenerating docs/shortcuts.md"

# Written to a temp file first. A failed build must not leave a truncated
# docs/shortcuts.md behind — a redirect opens the file before the command
# runs, so `cargo run > docs/shortcuts.md` empties it even if the build fails.
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
if ! cargo run --quiet -- --dump-shortcuts > "$tmp" 2>/dev/null; then
  echo "pre-commit: the build failed, so docs/shortcuts.md was left alone" >&2
  exit 1
fi
[ -s "$tmp" ] || { echo "pre-commit: --dump-shortcuts produced nothing" >&2; exit 1; }

cp "$tmp" docs/shortcuts.md
git add docs/shortcuts.md

# The website is a different repository, so its copy is refreshed but NOT
# committed — staging a change in someone else's checkout behind their back is
# not a thing a commit hook should do. Saying where it went is.
site=../trenches.sh/src/shortcuts.json
if [ -f "$site" ] && ! cmp -s shortcuts.json "$site"; then
  cp shortcuts.json "$site"
  echo "pre-commit: refreshed $site — commit it in trenches.sh too"
fi
